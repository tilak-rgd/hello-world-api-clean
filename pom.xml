<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<groupId>com.enterprise</groupId>
	<artifactId>hello-world-api</artifactId>
	<version>1.0.0</version>

	<packaging>mule-application</packaging>

	<name>hello-world-api</name>
	<description>Enterprise Hello World REST API - MuleSoft 4</description>

	<properties>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- Mule Runtime -->
		<app.runtime>4.10.0</app.runtime>

		<!-- Mule Maven Plugin -->
		<mule.maven.plugin.version>4.7.0</mule.maven.plugin.version>

		<!-- HTTP Connector -->
		<http.connector.version>1.10.0</http.connector.version>

		<!-- MUnit -->
		<munit.version>3.4.0</munit.version>

		<!-- SONARQUBE_GATE -->
		<sonar.maven.plugin.version>3.11.0.3922</sonar.maven.plugin.version>
		<sonar.projectKey>hello-world-api</sonar.projectKey>
		<sonar.sources>src/main</sonar.sources>
		<sonar.tests>src/test</sonar.tests>

		<!-- EXCHANGE_PUBLISH: override at publish time with
		     -Danypoint.org.id=<your Anypoint org id> -->
		<anypoint.org.id></anypoint.org.id>

	</properties>

	<build>
		<plugins>

			<!-- ===================================================== -->
			<!-- Mule Maven Plugin                                    -->
			<!-- ===================================================== -->

			<plugin>
				<groupId>org.mule.tools.maven</groupId>
				<artifactId>mule-maven-plugin</artifactId>
				<version>${mule.maven.plugin.version}</version>

				<extensions>true</extensions>

				<configuration>
					<classifier>mule-application</classifier>
				</configuration>
			</plugin>


			<!-- ===================================================== -->
			<!-- MUnit Maven Plugin                                    -->
			<!-- ===================================================== -->

			<plugin>
				<groupId>com.mulesoft.munit.tools</groupId>
				<artifactId>munit-maven-plugin</artifactId>
				<version>${munit.version}</version>

				<executions>
					<execution>
						<id>test</id>
						<phase>test</phase>

						<goals>
							<goal>test</goal>
							<goal>coverage-report</goal>
						</goals>
					</execution>
				</executions>

				<configuration>

					<!--
                        Let MUnit use its default generated test
                        directory.

                        DO NOT add:
                        <munitTestsDirectory>src/test/munit</munitTestsDirectory>
                    -->

					<!-- MUnit Runtime -->
					<runtimeVersion>${app.runtime}</runtimeVersion>

					<!-- Community Edition -->
					<runtimeProduct>MULE</runtimeProduct>

					<!-- Generate Surefire reports -->
					<enableSurefireReports>true</enableSurefireReports>

					<!-- Test output -->
					<testOutputDirectory>
						${project.build.directory}/munit-reports/output
					</testOutputDirectory>

					<!-- ================================================= -->
					<!-- Coverage (COVERAGE_GATE stage)                    -->
					<!-- ================================================= -->

					<coverage>

						<runCoverage>true</runCoverage>

						<!-- This is where failBuild is allowed -->
						<failBuild>false</failBuild>

						<requiredApplicationCoverage>80</requiredApplicationCoverage>
						<requiredResourceCoverage>50</requiredResourceCoverage>
						<requiredFlowCoverage>80</requiredFlowCoverage>

						<!-- BuildComponant parses target/site/munit/coverage/munit-coverage.json -->
						<formats>
							<format>HTML</format>
							<format>JSON</format>
						</formats>

					</coverage>

				</configuration>

			</plugin>

			<!-- ===================================================== -->
			<!-- SONARQUBE_GATE stage: `mvn sonar:sonar` with            -->
			<!-- -Dsonar.host.url / -Dsonar.login from the pipeline      -->
			<!-- ===================================================== -->

			<plugin>
				<groupId>org.sonarsource.scanner.maven</groupId>
				<artifactId>sonar-maven-plugin</artifactId>
				<version>${sonar.maven.plugin.version}</version>
			</plugin>

		</plugins>
	</build>

	<!-- ============================================================= -->
	<!-- EXCHANGE_PUBLISH stage: `mvn deploy` publishes the packaged    -->
	<!-- mule-application as an asset to this Anypoint Exchange org     -->
	<!-- ============================================================= -->

	<distributionManagement>
		<repository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange V3</name>
			<url>https://maven.anypoint.mulesoft.com/api/v3/organizations/${anypoint.org.id}/maven</url>
		</repository>
	</distributionManagement>


	<!-- ============================================================= -->
	<!-- Dependencies                                                  -->
	<!-- ============================================================= -->

	<dependencies>

		<!-- HTTP Connector -->
		<dependency>
			<groupId>org.mule.connectors</groupId>
			<artifactId>mule-http-connector</artifactId>
			<version>${http.connector.version}</version>
			<classifier>mule-plugin</classifier>
		</dependency>

		<!-- MUnit Runner -->
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-runner</artifactId>
			<version>${munit.version}</version>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>


		<!-- MUnit Tools -->
		<dependency>
			<groupId>com.mulesoft.munit</groupId>
			<artifactId>munit-tools</artifactId>
			<version>${munit.version}</version>
			<classifier>mule-plugin</classifier>
			<scope>test</scope>
		</dependency>

	</dependencies>


	<!-- ============================================================= -->
	<!-- Repositories                                                   -->
	<!-- ============================================================= -->

	<repositories>

		<!-- Anypoint Exchange -->
		<repository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange V3</name>
			<url>
				https://maven.anypoint.mulesoft.com/api/v3/maven
			</url>

			<layout>default</layout>

			<releases>
				<enabled>true</enabled>
			</releases>

			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>


		<!-- MuleSoft Releases -->
		<repository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<url>
				https://repository.mulesoft.org/releases/
			</url>

			<layout>default</layout>

			<releases>
				<enabled>true</enabled>
			</releases>

			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>

	</repositories>


	<!-- ============================================================= -->
	<!-- Plugin Repositories                                           -->
	<!-- ============================================================= -->

	<pluginRepositories>

		<!-- MuleSoft Plugin Repository -->
		<pluginRepository>
			<id>mulesoft-releases</id>
			<name>MuleSoft Releases Repository</name>
			<url>
				https://repository.mulesoft.org/releases/
			</url>

			<layout>default</layout>

			<releases>
				<enabled>true</enabled>
			</releases>

			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</pluginRepository>


		<!-- Anypoint Exchange -->
		<pluginRepository>
			<id>anypoint-exchange-v3</id>
			<name>Anypoint Exchange V3</name>
			<url>
				https://maven.anypoint.mulesoft.com/api/v3/maven
			</url>

			<layout>default</layout>

			<releases>
				<enabled>true</enabled>
			</releases>

			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</pluginRepository>

	</pluginRepositories>

</project>